core-be() {
  sudo -iu "${1-root}"
}

core-all() {
  sudo -iu root -- "$@"
  sudo -iu {{ .owner }} -- "$@"
  sudo -iu {{ .agent }} -- "$@"
}

core-reload() {
  chezmoi verify || core-all chezmoi apply
  cd "$HOME"
  exec "$SHELL" -il
  # NOTE: This does not unset exported variables (reopen terminal instead)
}

if [[ -n "$ZSH_VERSION" ]]; then
  compdef _precommand core-all
fi
