export PROXY_VSCODE="/home/{{ .owner }}/.local/shim/proxy-code"

pi_hub="/home/{{ .owner }}/garden/pi-hub"

owner-pi() {
  agent-pi \
    --session-dir "$pi_hub/sessions/" \
    --system-prompt "$pi_hub/coder.md"
}

agent-pi() {
  _init-proxy-vscode
  sudo -iu {{ .agent }} sh -c '
    cd "$1" && shift
    exec pi "$@"
  ' sh "$PWD" "$@"
}

agent-clean() {
  sudo -iu {{ .agent }} sh -c '
    rm -rf "$HOME/.deltabox"
  '
}

_init-proxy-vscode() {
  local this
  [ -n "$ZSH_VERSION" ] && this="${(%):-%x}" || this="${BASH_SOURCE[0]}"
  cat << EOF > "$PROXY_VSCODE"
#!/bin/sh
# Generated by '"$this"'
[[ \$# -eq 1 ]] || exit 1
export VSCODE_IPC_HOOK_CLI="$VSCODE_IPC_HOOK_CLI"
exec "$(command -v code)" --wait -- "\$1"
EOF
  # rwx r-x r-x
  chmod 755 "$PROXY_VSCODE"
}
