{{- $path := promptStringOnce . "path" "The path of the dotfiles" -}}
{{- $owner := promptStringOnce . "owner" "The username of the owner" -}}
{{- $agent := promptStringOnce . "agent" "The username of the agent" -}}

sourceDir = {{ $path | quote }}

[data]
  path = {{ $path | quote }}
  owner = {{ $owner | quote }}
  agent = {{ $agent | quote }}
