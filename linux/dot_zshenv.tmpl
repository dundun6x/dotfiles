export HOST_IP=$(ip route | awk '/default/ {print $3; exit}')
export PROXY_VSCODE="/home/{{ .owner }}/.local/shim/proxy-code"

typeset -U path
path=("$HOME/.local/shim" "$HOME/.local/bin" "$HOME/.cargo/bin" $path)
export PATH
export EDITOR="wrap-code"
export VISUAL="wrap-code"
export GRAVEYARD="$HOME/.local/share/trash"
