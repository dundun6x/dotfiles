# If not running interactively, do nothing
[[ -o interactive ]] || return 0

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100
SAVEHIST=100
PROMPT='[%n@%m %1~]%# '

setopt SHARE_HISTORY

shellrc_dir="$HOME/.config/shellrc"
zsh_plugin_dir="$HOME/.local/share/zsh/plugins"

source "$shellrc_dir/core.sh"
alias r=reload-user
alias rr=reload-all
alias c=clear

source "$shellrc_dir/workspace.sh"
alias j=ws-jump
alias s=ws-source
alias l=ws-load
# Short options are '-alhmU'
alias ll='eza --all --long --header --modified --created \
  --time-style="+%Y-%m-%d %H:%M"'

source "$shellrc_dir/file.sh"
alias share=share-add
alias sharerm=share-remove
alias sharels=share-list
alias own='sudo chown -R $USER'

source "$shellrc_dir/proxy.sh"
source "$shellrc_dir/git.sh"

{{- if eq .chezmoi.username .owner }}

source "$shellrc_dir/owner.sh"
alias pi=owner-pi

{{- end }}

source "$zsh_plugin_dir/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$zsh_plugin_dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

unset shellrc_dir
unset zsh_plugin_dir
